  ---------------- the kernel ----------------
  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def nki_matmul_tiled_(lhsT, rhs):
      M = lhsT.shape[1]
      N = rhs.shape[1]
      K = lhsT.shape[0]
    
      # Allocate output buffer in shared HBM
      out = nl.ndarray((M, N), dtype=lhsT.dtype, buffer=nl.shared_hbm)
    
      # Allocate SBUF for stationary and moving operands
      sbuf_stationary = nl.ndarray((K, M), dtype=lhsT.dtype, buffer=nl.sbuf)
      sbuf_moving = nl.ndarray((K, N), dtype=rhs.dtype, buffer=nl.sbuf)
    
      # Copy lhsT to sbuf_stationary in chunks of 128
      for i in nl.affine_range(0, K, 128):
          chunk_size = min(128, K - i)
          nisa.dma_copy(dst=sbuf_stationary[i:i+chunk_size, :], src=lhsT[i:i+chunk_size, :])
    
      # Copy rhs to sbuf_moving in chunks of 128
      for i in nl.affine_range(0, K, 128):
          chunk_size = min(128, K - i)
          nisa.dma_copy(dst=sbuf_moving[i:i+chunk_size, :], src=rhs[i:i+chunk_size, :])
    
      # Split M into chunks of at most 128 and N into chunks of at most 512
      for m0 in nl.affine_range(0, M, 128):
          for n0 in nl.affine_range(0, N, 512):
              chunk_m = min(128, M - m0)
              chunk_n = min(512, N - n0)
            
              # Allocate PSUM buffer for current chunk
              psum = nl.ndarray((chunk_m, chunk_n), dtype=nl.float32, buffer=nl.psum)
            
              # Perform NC matmul in chunks of 128
              for i in nl.affine_range(0, K, 128):
                  chunk_size = min(128, K - i)
                  nisa.nc_matmul(
                      dst=psum,
                      stationary=sbuf_stationary[i:i+chunk_size, m0:m0+chunk_m],
                      moving=sbuf_moving[i:i+chunk_size, n0:n0+chunk_n]
                  )
            
              # Copy result from PSUM to SBUF
              sbuf_out = nl.ndarray((chunk_m, chunk_n), dtype=lhsT.dtype, buffer=nl.sbuf)
              nisa.tensor_copy(dst=sbuf_out, src=psum)
            
              # Copy result from SBUF to shared HBM
              nisa.dma_copy(dst=out[m0:m0+chunk_m, n0:n0+chunk_n], src=sbuf_out)
    
      return out
